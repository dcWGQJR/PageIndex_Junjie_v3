# Copy this file to `pageindex.env` and fill in your key.
# (The file is named `pageindex.env` rather than `.env` because the virtualenv
#  in this folder is itself a directory named `.env`.)

# Which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default model.
# Defaults are:
#   openai     -> gpt-4o-mini-2024-07-18
#   anthropic  -> claude-sonnet-4-6
# PAGEINDEX_MODEL=gpt-4o-mini-2024-07-18
